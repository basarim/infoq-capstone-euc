# Copy to .env (already gitignored) for your own reference, then export
# these into your shell before running the app — this repo's Python code
# reads them via os.environ, not from this file directly.
#
#   export ANTHROPIC_API_KEY=your-anthropic-api-key
#   export ANTHROPIC_WORKSPACE_ID=your-workspace-id   # optional, only needed for identity-linked keys
#   export LLM_MODEL=claude-sonnet-4-6   # optional, this is the default
#
# The LANGFUSE_* variables are only needed for
# euc.grantfitassessment.eval.langfuse_evaluation_runner (observability —
# see README). Without the public/secret keys, that runner still completes
# normally; it just has nothing to send anywhere. LANGFUSE_TRACING_ENVIRONMENT
# is optional (defaults to "default") — set it to keep these evaluation-run
# traces distinguishable from any other environment sending traces to the
# same Langfuse project.

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-sonnet-4-6
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=
