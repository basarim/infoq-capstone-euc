# Copy to .env (already gitignored) for your own reference, then export
# these into your shell before running the app — this repo's Java code
# reads them via System.getenv(), not from this file directly.
#
#   export LLM_API_KEY=your-anthropic-api-key
#   export LLM_MODEL=claude-sonnet-4-6   # optional, this is the default

LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
