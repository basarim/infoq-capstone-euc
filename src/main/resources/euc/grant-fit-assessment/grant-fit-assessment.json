{
  "id": "grant-fit-assessment",
  "actor": "Nonprofit Program Manager",
  "goal": "Determine whether the organization should pursue a grant",
  "context": {
    "description": "Shared object passed through the pipeline. Each filter reads from and writes to this context rather than exchanging isolated arguments; evaluation stages read the same context the execution stages wrote into, rather than a copy.",
    "seedFields": ["organization", "grant"]
  },
  "executionPipeline": [
    {
      "id": "ELIGIBILITY-001",
      "filter": "eligibility",
      "type": "deterministic",
      "description": "Applicant must satisfy mandatory eligibility requirements",
      "onFailure": "halt",
      "group": 1,
      "reads": ["organization", "grant"],
      "writes": ["eligible", "failedEligibilityRules"]
    },
    {
      "id": "GEOGRAPHY-001",
      "filter": "geography",
      "type": "deterministic",
      "description": "Applicant must operate within the grant's specified geographic scope",
      "onFailure": "halt",
      "group": 2,
      "reads": ["organization", "grant"],
      "writes": ["eligible", "failedEligibilityRules"]
    },
    {
      "id": "INFO-001",
      "filter": "requiredInfo",
      "type": "deterministic",
      "description": "All required application information must be present before assessment proceeds",
      "onFailure": "halt",
      "group": 3,
      "reads": ["organization"],
      "writes": ["eligible", "failedEligibilityRules"]
    },
    {
      "id": "ALIGNMENT-001",
      "filter": "alignmentReasoning",
      "type": "reasoned",
      "description": "Organization's mission and programs must be assessed for alignment with the funder's stated priorities",
      "onFailure": "continue",
      "group": 4,
      "reads": ["organization", "grant", "eligible"],
      "writes": ["fitClassification", "explanation", "supportingEvidence", "identifiedUncertainty"]
    }
  ],
  "policies": [
    "Do not invent missing information",
    "Support conclusions with evidence",
    "Flag uncertainty rather than defaulting to a confident conclusion"
  ],
  "expectedOutcomes": [
    "STRONG_FIT",
    "POSSIBLE_FIT",
    "POOR_FIT"
  ],
  "evaluationPipeline": [
    {
      "id": "eligibilityCorrectness",
      "filter": "eligibilityCorrectness",
      "evaluates": ["ELIGIBILITY-001", "GEOGRAPHY-001", "INFO-001"],
      "group": 1,
      "reads": ["eligible", "failedEligibilityRules"]
    },
    {
      "id": "programAlignment",
      "filter": "programAlignment",
      "evaluates": ["ALIGNMENT-001"],
      "group": 2,
      "reads": ["fitClassification"]
    },
    {
      "id": "evidenceGrounding",
      "filter": "evidenceGrounding",
      "evaluates": ["ALIGNMENT-001"],
      "group": 3,
      "reads": ["supportingEvidence"]
    }
  ]
}
